{
  "name": "app",
  "type": "module",
  "version": "1.3.6",
  "description": "The Harnessing Talent website, built with Astro",
  "homepage": "https://ht.apollogeddon.com",
  "scripts": {
    "dev": "astro dev",
    "type": "astro check",
    "lint:ts": "biome check --fix",
    "lint:md": "markdownlint-cli2 --fix",
    "lint": "biome check --fix && npm run lint:md",
    "build": "astro build",
    "preview": "astro preview",
    "pretest": "playwright install --with-deps",
    "test": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "security": "osv-scanner scan -r .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@apollogeddon/forgejs": "4.0.0",
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "markdownlint-cli2": "0.23.3",
    "tailwindcss": "4.3.3"
  },
  "private": true,
  "overrides": {
    "katex": "^0.19.0"
  }
}

{
  "name": "app",
  "type": "module",
  "version": "1.3.4",
  "homepage": "https://ht.apollogeddon.com",
  "scripts": {
    "dev": "astro dev",
    "type": "astro sync && tsc --noEmit --ignoreDeprecations 5.0",
    "lint:ts": "biome check --fix",
    "lint:md": "markdownlint-cli2 --fix",
    "lint": "biome check --fix && npm run lint:md",
    "build": "astro build",
    "preview": "astro preview",
    "pretest": "playwright install --with-deps",
    "test": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "security": "osv-scanner scan -r .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@apollogeddon/forgejs": "3.2.1",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.8",
    "markdownlint-cli2": "0.23.3",
    "tailwindcss": "4.3.3"
  },
  "private": true
}

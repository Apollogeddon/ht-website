{
  "name": "ht-website",
  "type": "module",
  "version": "1.5.3",
  "description": "The Harnessing Talent website, built with Astro",
  "homepage": "https://ht.apollogeddon.com",
  "scripts": {
    "dev": "astro dev",
    "type": "astro check",
    "lint:ts": "biome check --fix",
    "lint:md": "markdownlint-cli2 --fix",
    "lint": "biome check --fix && npm run lint:md",
    "build": "astro build",
    "preview": "astro preview",
    "lhci": "lhci autorun",
    "pretest": "playwright install --with-deps",
    "test": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "security": "osv-scanner scan -r .",
    "prepare": "lefthook install || exit 0"
  },
  "devDependencies": {
    "@apollogeddon/forgejs": "^7.0.0",
    "@astrojs/check": "0.9.11",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "markdownlint-cli2": "0.23.3",
    "tailwindcss": "4.3.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "katex": "^0.19.0",
    "smol-toml": "^1.9.1",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "basic-ftp": "^6.2.3",
    "@puppeteer/browsers": "^3.2.5"
  }
}

---
interface Props {
  orgs: string[];
}

const { orgs } = Astro.props;
---

<div class="py-6 bg-[var(--bg-primary)]">
  <div class="container-site">
    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3 text-center">
      <p class="text-xs font-semibold text-[var(--text-secondary)] whitespace-nowrap uppercase tracking-[0.12em]">
        Trusted by:
      </p>
      <span
        class="trusted-by-pill text-base font-semibold text-[var(--text-primary)] transition-opacity duration-300"
        data-orgs={JSON.stringify(orgs)}
      >
        {orgs[0]}
      </span>
    </div>
  </div>
</div>

<script>
  // Each page load starts a rotation, so the last page's must stop when the client router swaps it out.
  let rotations: ReturnType<typeof setInterval>[] = [];
  const stopTrustedBy = () => {
    rotations.forEach(clearInterval);
    rotations = [];
  };

  const initTrustedBy = () => {
    stopTrustedBy();
    document.querySelectorAll<HTMLElement>(".trusted-by-pill").forEach((pill) => {
      const orgs: string[] = JSON.parse(pill.dataset.orgs ?? "[]");
      if (orgs.length <= 1) return;
      let i = 0;
      rotations.push(
        setInterval(() => {
          pill.style.opacity = "0";
          setTimeout(() => {
            i = (i + 1) % orgs.length;
            pill.textContent = orgs[i] ?? "";
            pill.style.opacity = "1";
          }, 300);
        }, 3000),
      );
    });
  };

  document.addEventListener("astro:page-load", initTrustedBy);
  document.addEventListener("astro:before-swap", stopTrustedBy);
</script>

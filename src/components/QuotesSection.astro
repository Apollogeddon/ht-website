---
import Quote from "./Quote.astro";

interface QuoteItem {
  text: string;
  author: string;
}

interface Props {
  quotes: QuoteItem[];
}

const { quotes } = Astro.props;
---

<section class="section-padding-sm bg-[var(--bg-primary)]">
  <div class="container-site">
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
      {quotes.map((q, i) => (
        <Quote text={q.text} author={q.author} variant="grid" class="scroll-reveal" style={`--delay: ${i * 90}ms`} />
      ))}
    </div>
  </div>
</section>
